# ========================================================
# Dockerfile.api (Para o microsserviço Node.js / Fastify)
# ========================================================
FROM node:20-alpine AS builder
WORKDIR /app

# Suporte para npm / pnpm
COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma/

RUN npm install

COPY . .

RUN npx prisma generate
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
COPY prisma ./prisma/
RUN npm install --omit=dev

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

EXPOSE 3000

# Flags de otimização de GC e controle de memória do V8
CMD ["node", "--optimize-for-size", "--max-old-space-size=400", "dist/server.js"]

