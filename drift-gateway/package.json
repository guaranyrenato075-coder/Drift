{
  "name": "cutwire-drift-gateway",
  "version": "1.0.0",
  "description": "High-performance Node.js / Fastify / BullMQ Gateway for CutWire Drift",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:tuned": "node --optimize-for-size --max-old-space-size=512 --gc-interval=100 dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@msgpack/msgpack": "^3.1.3",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
